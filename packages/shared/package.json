{
  "name": "@token-manager/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./brand-files": {
      "types": "./dist/brand-files.d.ts",
      "import": "./dist/brand-files.js",
      "default": "./dist/brand-files.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "dependencies": {
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
