# Optional override for the MCP local session file.
# The file is gitignored. Do not put seeds, API keys, or OAuth secrets in it.
# TOKEN_MANAGER_SESSION_PATH=.token-manager/session.json

# Optional Cloudflare Intel WHOIS hint for domain_plan.
# Leave both unset to stay offline. Never pass these as MCP tool arguments.
# The tool does not buy a domain. A missing WHOIS record is not proof the .com is for sale.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional directory for generated brand SVGs. Defaults to artifacts/brand under the repo.
# TOKEN_MANAGER_BRAND_DIR=
